# server/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is listed in .gitignore.
# In GitHub Actions, add these as repository Secrets
# (Settings → Secrets and variables → Actions → New repository secret).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/lean_game

# Secret key used to sign JSON Web Tokens — use a long, random string in prod
JWT_SECRET=CHANGE_ME_use_a_long_random_string_here

# Port the Express server listens on
PORT=3001
